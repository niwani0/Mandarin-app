{
  "expo": {
    "name": "Mandarin Travel",
    "slug": "mandarin-app",
    "scheme": "mandarintravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandarintravel.personal",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used to record you speaking Mandarin so the app can give you tone/pronunciation feedback.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mandarintravel.personal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Used to record you speaking Mandarin so the app can give you tone/pronunciation feedback."
        }
      ]
    ]
  }
}
